{
  "name": "@midnight-ntwrk/guess-who-server",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "node --experimental-specifier-resolution=node --import tsx/esm src/preview.ts",
    "preprod": "node --experimental-specifier-resolution=node --import tsx/esm src/preprod.ts",
    "preprod-ps": "docker compose -f proof-server.yml pull && node --experimental-specifier-resolution=node --import tsx/esm src/preprod-start-proof-server.ts",
    "mainnet": "node --experimental-specifier-resolution=node --import tsx/esm src/mainnet.ts",
    "mainnet-ps": "docker compose -f proof-server.yml pull && node --experimental-specifier-resolution=node --import tsx/esm src/mainnet-start-proof-server.ts",
    "deploy:mainnet": "node --experimental-specifier-resolution=node --import tsx/esm src/deploy-mainnet.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/guess-who-contract": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "tsx": "^4.21.0"
  }
}
